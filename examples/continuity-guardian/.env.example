# Continuity Guardian — inspect-only defaults (no secrets)

# Path to MissionPolicy JSON (relative to this package root)
POLICY_PATH=policies/example-mission.policy.json

# Comma-separated durable slot ids (unix seconds schedule anchors)
EXPECTED_SLOTS=1000,1300,1600,1900,2200
CONFIRMED_SLOTS=1000,1300

# Optional journal replays as JSON array: [{"slot":1600,"txHash":"0xabc..."}]
# Dry-run hashes (0xdry...) never count as coverage.
JOURNAL_REPLAYS_JSON=[]

# WRITE_MODE=1 is an explicit gate. This example never executes writes;
# it only refuses and prints guidance. Keep at 0 for inspect-only.
WRITE_MODE=0
