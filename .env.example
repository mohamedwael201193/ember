# =============================================================================
# EMBER environment template
# Copy to `.env` (pnpm setup does this for you) and fill real values for live mode.
# Never commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Mode
# DEVELOPMENT_MODE=1  → local UI + mock runtime + sample evidence (no real secrets)
# DEVELOPMENT_MODE=0  → live KeeperHub / RPC / Pinata credentials required
# -----------------------------------------------------------------------------
DEVELOPMENT_MODE=1
EMBER_DEV_MODE=1
EMBER_NETWORK=development
EMBER_RUNTIME_URL=http://127.0.0.1:10000

# -----------------------------------------------------------------------------
# KeeperHub (required for live mode)
# Auth is ALWAYS: Authorization: Bearer kh_...
# Never put kh_ keys in browser / VITE_ vars.
# -----------------------------------------------------------------------------
KH_API_BASE=https://app.keeperhub.com
KH_MCP_URL=https://app.keeperhub.com/mcp
KH_ORG_A_NAME=ember-org-a
KH_API_KEY_PRIMARY_EXECUTOR=
KH_API_KEY_PRIMARY_OBSERVER=
ORG_A_WALLET_ADDRESS=
ORG_A_WALLET_INTEGRATION_ID=
KH_ORG_B_NAME=ember-org-b
KH_API_KEY_STANDBY=
ORG_B_WALLET_ADDRESS=
ORG_B_WALLET_INTEGRATION_ID=
KH_ORG_A_W1_WORKFLOW_ID=
KH_ORG_A_W1_MAINNET_WORKFLOW_ID=
KH_ORG_B_W1_REPLAY_WORKFLOW_ID=
KH_ORG_B_W1_REPLAY_MAINNET_WORKFLOW_ID=
KH_ORG_B_W2_WORKFLOW_ID=
KH_ORG_B_W3_WORKFLOW_ID=

# -----------------------------------------------------------------------------
# Chain / RPC
# -----------------------------------------------------------------------------
CHAIN_ID_MAINNET=8453
CHAIN_ID_REHEARSAL=84532
BASE_RPC_URL=
BASE_RPC_URL_FALLBACK=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_RPC_URL_FALLBACK=https://sepolia.base.org
USDC_ADDRESS_BASE=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDC_ADDRESS_BASE_SEPOLIA=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# -----------------------------------------------------------------------------
# Deployer (Foundry only — never load into long-running services)
# -----------------------------------------------------------------------------
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
ETHERSCAN_API_KEY=

# -----------------------------------------------------------------------------
# Employee / wallets
# -----------------------------------------------------------------------------
EMPLOYEE_ADDRESS=

# -----------------------------------------------------------------------------
# Mission economics
# -----------------------------------------------------------------------------
PAYMENT_AMOUNT_USDC=10000
PAYROLL_BUDGET_USDC=5000000
ESCROW_FUND_USDC=1000000
MAINNET_TOTAL_SPEND_CAP_USDC=10000000
CADENCE_SECONDS=300
GRACE_MISSED_RUNS=2
SENTINEL_POLL_SECONDS=120
SENTINEL_SELF_POLL=1
CLOCK_SKEW_SECONDS=60
RECEIPT_CONFIRMATIONS=3
MAX_REPLAY_SLOTS=12
X402_FEE_USDC=50000
X402_MAX_FEE_USDC=500000

# -----------------------------------------------------------------------------
# Continuity / mission IDs
# -----------------------------------------------------------------------------
CONTINUITY_ADDRESS_SEPOLIA=
CONTINUITY_ADDRESS_MAINNET=
MISSION_ID_SEPOLIA=1
MISSION_ID_MAINNET=1
MISSION_START_AT=
MISSION_START_AT_MAINNET=
WORKFLOW_HASH_SEPOLIA=
WORKFLOW_HASH_MAINNET=

# -----------------------------------------------------------------------------
# IPFS / Pinata
# -----------------------------------------------------------------------------
PINATA_JWT=
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
PROOF_ANCHOR_ENABLE=0

# -----------------------------------------------------------------------------
# Services / BFF
# -----------------------------------------------------------------------------
PORT=10000
SENTINEL_PORT=8787
PRIMARY_OBSERVER_PORT=8788
PAYDAY_PORT=8789
BFF_PORT=8780
PAYDAY_ENABLE=0
SENTINEL_PUBLIC_URL=http://127.0.0.1:10000
PRIMARY_OBSERVER_PUBLIC_URL=http://127.0.0.1:8788
PRIMARY_OBSERVER_URL=http://127.0.0.1:8788
SENTINEL_SHARED_SECRET=
PRIMARY_OBSERVER_SHARED_SECRET=
PAYDAY_CONTROL_TOKEN=
RESCUE_JOURNAL_DIR=./runtime/rescues
PAYDAY_JOURNAL_DIR=./runtime/payday
PAYDAY_JOURNAL_FILE=
W1_CANONICAL_PATH=workflows/w1-payday-stream.json
LOG_LEVEL=info
WATCH_INTERVAL_MS=15000
WATCH_BASE=
WATCH_SLOTS=

# -----------------------------------------------------------------------------
# Marketplace / Hub (optional)
# -----------------------------------------------------------------------------
W2_HUB_SLUG=continuity-wrapper
W3_MARKETPLACE_SLUG=ember-restore-and-replay
X402_PAYER_WALLET_ADDRESS=

# -----------------------------------------------------------------------------
# Optional integrations
# -----------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Deploy tooling (optional — local operators only)
# -----------------------------------------------------------------------------
RENDER_API_KEY=
RENDER_OWNER_ID=
RENDER_REPO=
RENDER_BRANCH=main
RENDER_SERVICE_NAME=ember-api
RENDER_REUSE_SERVICE=
RENDER_SERVICE_ID=
RENDER_EMBER_API_ID=
GITHUB_TOKEN=
vercel_token=
